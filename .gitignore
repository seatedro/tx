*
# Git doesn't look inside an ignored directory, so directories are let
# through. Their files stay ignored unless a line below allows them.
!*/

!/.gitignore
!/.github/**
!/.clang-format
!/README.md
!/LICENSE
!/assets/**

!/flake.nix
!/flake.lock
!/nix/**
!/build.zig
!/build.zig.zon
!/install.sh
!/src/**
!/scripts/**
