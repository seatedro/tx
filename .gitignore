# Ignore everything by default; allow only what belongs in the repo.
# Rules are anchored to the root so they never match inside zig-pkg/.
*
!*/

!/.gitignore
!/.github/**
!/.clang-format
!/README.md
!/LICENSE
!/assets/**

!/flake.nix
!/flake.lock
!/build.zig
!/build.zig.zon
!/install.sh
!/src/**
!/scripts/**
